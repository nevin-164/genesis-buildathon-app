# ── Postgres (Supabase → Project Settings → Database → Connection string) ───
# App: the Supavisor pooler, port 6543. The client sets prepare:false for this.
DATABASE_URL=
# Migrations: the direct connection, port 5432. drizzle-kit uses this.
DIRECT_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=

# ── Supabase Storage only (no Supabase Auth, no Supabase data access) ───────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENTS_BUCKET=documents

# ═══════════════════════════════════════════════════════════════════════════
# Everything below belongs to a second-wave package. Every key is listed here
# already so that five feature branches never append to this file and never
# collide in it. Fill in only the block your package owns; the seams all
# degrade to a no-op when their keys are blank, so an unfilled block leaves
# the app working exactly as it does today.
# ═══════════════════════════════════════════════════════════════════════════

# ── Package A · rate limiting (Upstash → Redis → REST API) ──────────────────
# Both blank = the limiter allows everything. That is the committed default,
# so nobody needs an Upstash account to run the app locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Package B · OAuth ───────────────────────────────────────────────────────
# Google:  console.cloud.google.com → APIs & Services → Credentials
#          Authorised redirect URI: <base>/api/auth/google/callback
# GitHub:  github.com/settings/developers → New OAuth App
#          Authorisation callback URL: <base>/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# No trailing slash. http://localhost:3000 in development, the deployed
# origin in production. The provider redirect URIs are built from this.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# ── Package C · email verification (resend.com → API Keys) ──────────────────
# RESEND_API_KEY blank = the mail send is skipped and the verification link is
# written to the server console instead, so registration still works offline.
RESEND_API_KEY=
EMAIL_FROM=InternLens <onboarding@resend.dev>
# Where the link in the email points. Same value as OAUTH_REDIRECT_BASE_URL.
APP_BASE_URL=http://localhost:3000

# ── Package D · AI internship report (console.anthropic.com) ────────────────
# Blank = the generator returns a clearly-marked placeholder instead of
# calling the model, so the screen is still demonstrable without a key.
ANTHROPIC_API_KEY=
