# ── Postgres (Supabase → Project Settings → Database → Connection string) ───
# App: the Supavisor pooler, port 6543. The client sets prepare:false for this.
DATABASE_URL=
# Migrations: the direct connection, port 5432. drizzle-kit uses this.
DIRECT_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=

# ── Supabase Storage only (no Supabase Auth, no Supabase data access) ───────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENTS_BUCKET=documents

# ═══════════════════════════════════════════════════════════════════════════
# Everything below belongs to a second-wave package. Every key is listed here
# already so that five feature branches never append to this file and never
# collide in it. Fill in only the block your package owns; the seams all
# degrade to a no-op when their keys are blank, so an unfilled block leaves
# the app working exactly as it does today.
# ═══════════════════════════════════════════════════════════════════════════

# ── Package A · rate limiting (Upstash → Redis → REST API) ──────────────────
# Both blank = the limiter allows everything. That is the committed default,
# so nobody needs an Upstash account to run the app locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Package B · OAuth (Google only) ─────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
#   Application type:         Web application
#   Authorised redirect URI:  <OAUTH_REDIRECT_BASE_URL>/api/auth/google/callback
#
# The redirect URI must match byte for byte, trailing slash included, or Google
# rejects the request with an error that does not say which part is wrong.
#
# Either value blank = the provider button on /login stays disabled and the
# route returns 501, so the app still runs without Google credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No trailing slash. http://localhost:3000 in development, the deployed
# origin in production. The provider redirect URIs are built from this.
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# ── Package C · email verification (Mailgun) ────────────────────────────────
# Mailgun dashboard → Send → Domain settings → API keys.
#
# Either key blank = the mail send is skipped and the verification link is
# written to the server console instead, so registration still works offline
# and nobody else on the team needs a Mailgun account.
MAILGUN_API_KEY=
# The sending domain, e.g. sandbox1234abcd.mailgun.org while you are testing,
# or mail.internlens.app once a real domain is verified.
MAILGUN_DOMAIN=
# US (default) is https://api.mailgun.net — set the EU host instead if the
# Mailgun account was created in the EU region. Sending to the wrong region
# fails with a 401 that looks exactly like a bad API key.
MAILGUN_API_BASE=https://api.mailgun.net
# Must be on MAILGUN_DOMAIN or Mailgun rejects the message.
EMAIL_FROM=InternLens <postmaster@sandbox1234abcd.mailgun.org>
# Where the link in the email points. Same value as OAUTH_REDIRECT_BASE_URL.
APP_BASE_URL=http://localhost:3000

# ── Package D · AI internship report (console.anthropic.com) ────────────────
# Blank = the generator returns a clearly-marked placeholder instead of
# calling the model, so the screen is still demonstrable without a key.
ANTHROPIC_API_KEY=
