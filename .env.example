# ── Development role switch ─────────────────────────────────────────────────
# TEMPORARY, until package 1 (Auth) ships the real login.
# Set this to work on your screens without signing in. Change the value and
# reload to switch role. Ignored unless NODE_ENV is "development".
DEV_FAKE_ROLE=student        # student | faculty | admin

# ── Postgres (Supabase → Project Settings → Database → Connection string) ───
# App: the Supavisor pooler, port 6543. The client sets prepare:false for this.
DATABASE_URL=
# Migrations: the direct connection, port 5432. drizzle-kit uses this.
DIRECT_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=

# ── Supabase Storage only (no Supabase Auth, no Supabase data access) ───────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_BUCKET=evidence
